# Public media Worker URL. Never put API secrets in VITE variables.
VITE_MEDIA_API_URL=https://asbesoc-media.asbesocngo.workers.dev

# Keep disabled until reviewed rules, indexes and functions have been deployed
# and staging authentication, App Check and payment verification tests pass.
VITE_MEMBERSHIP_SERVICE_ENABLED=false
VITE_WEBSITE_ANALYTICS_ENABLED=false
VITE_FIREBASE_APPCHECK_SITE_KEY=
# PAYSTACK_SECRET_KEY belongs only in Firebase Secret Manager, never VITE_*.
